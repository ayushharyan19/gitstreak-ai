AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
AUTH_SECRET=

# Supabase project Settings → API. Keep the service-role key server-side only.
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Web Push VAPID credentials
# Generate using: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@gitstreak.ai

# Resend Email Provider credentials
RESEND_API_KEY=
EMAIL_FROM=GitStreak AI <notifications@gitstreak.ai>

# Secret to authenticate scheduled reminder cron executions
CRON_SECRET=
